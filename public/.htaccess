# Groovy - Apache Configuration for /groovy/
# Upload this file to the /groovy/ directory on your server

# Enable rewrite engine
RewriteEngine On

# Redirect all requests to index.html (for React Router)
# This allows client-side routing to work properly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Enable gzip compression for better performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache static assets for better performance
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  
  # Audio files (drum samples)
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType audio/mp3 "access plus 1 year"
  
  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  
  # HTML (no cache for main page)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  # Content-Security-Policy scoped to what this app actually loads.
  #
  # Apache keeps two independent response-header tables: the site-wide policy is
  # set at the root with plain `Header set` (the "onsuccess" table), while ours
  # uses `Header always set` (the "always" table). A set in one table never
  # replaces the other, and browsers enforce every CSP header they receive as an
  # intersection. Unset the site-wide one here so /groovy/ sends exactly one
  # policy: the one below.
  Header unset Content-Security-Policy
  #
  # Origins, by directive:
  #   script-src   Vite bundle (self), www.bahar.co.il (universal-analytics.js),
  #                cdn.amplitude.com (Amplitude SDK injected by that script).
  #                No inline scripts and no eval are used, so no inline or
  #                eval allowance is granted for scripts.
  #   style-src    React style= attributes and abcjs need 'unsafe-inline';
  #                Google Fonts (Inter) and cdnjs (Font Awesome) stylesheets.
  #   font-src     Google Fonts files, Font Awesome webfonts, data: fallbacks.
  #   img-src      data: (QR codes, canvas exports) and blob: (SVG -> PNG export).
  #   connect-src  drum samples (self), go.bahar.co.il (URL shortener),
  #                Amplitude ingest + remote-config hosts (EU zone in use; US
  #                hosts listed so a zone change does not silently drop analytics).
  #   frame-ancestors *  The Share > Embed feature gives users an <iframe> snippet
  #                for their own sites, so third-party framing is intentional.
  #                This directive supersedes X-Frame-Options, which is unset below.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.bahar.co.il https://cdn.amplitude.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://www.bahar.co.il https://go.bahar.co.il https://api.amplitude.com https://api2.amplitude.com https://api.eu.amplitude.com https://sr-client-cfg.amplitude.com https://sr-client-cfg.eu.amplitude.com; frame-ancestors *; object-src 'none'; base-uri 'self'; form-action 'self'"

  # Framing policy lives in frame-ancestors above; drop the legacy header so
  # the site-wide (invalid) "ALLOWALL" value is not sent for this path.
  Header always unset X-Frame-Options

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Enable XSS protection
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy (restrict features)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Set correct MIME types
<IfModule mod_mime.c>
  AddType audio/mpeg .mp3
  AddType application/javascript .js
  AddType text/css .css
</IfModule>